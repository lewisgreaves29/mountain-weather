{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MountainWeatherLocationsConfig",
  "type": "object",
  "required": ["regions"],
  "properties": {
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "layout", "sub_regions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "layout": { "type": "string", "enum": ["detailed", "compact"] },
          "sub_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "target_fells", "valley", "summit"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "target_fells": { "type": "string" },
                "valley": { "$ref": "#/$defs/locationPoint" },
                "summit": { "$ref": "#/$defs/locationPoint" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "locationPoint": {
      "type": "object",
      "required": ["name", "lat", "lon", "elevation"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "elevation": { "type": "number", "minimum": -50, "maximum": 9000 }
      }
    }
  }
}
